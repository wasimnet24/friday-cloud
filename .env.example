# Friday Cloud -- 24/7 relay (Render free hosting pe deploy karo)
# Guide: CLOUD_SETUP.md

# Lamba random token (phone + PC dono me SAME hona chahiye):
#   python -c "import secrets; print(secrets.token_hex(24))"
CLOUD_TOKEN=

# ---- AI providers: auto-failover (order = preference, pehla healthy jeetta hai) ----
# Keys Render Dashboard -> Environment me dalo. GitHub/code me kabhi mat daalna.
AI_PROVIDERS=vyceai,openrouter,apinex,xkiro,kiosapi,nvidia
AI_PROVIDER_TIMEOUT=20
AI_PROVIDER_COOLDOWN=120

VYCEAI_API_KEY=
# VYCEAI_MODEL=deepseek-v4-flash

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

APINEX_API_KEY=
# APINEX_MODEL=free/glm-5.3-flash

XKIRO_API_KEY=
# XKIRO_MODEL=qwen/qwen3.7-flash:free

KIOSAPI_API_KEY=
# KIOSAPI_MODEL=gpt-6-sol

# NOTE: AgentRouter yahan kaam nahi karega -- uska WAF datacenter IPs ko
# block karta hai ("unauthorized client detected"). Sirf ghar ke PC par.

# ---- NVIDIA fallback (build.nvidia.com se free key) ----
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MAX_TOKENS=220
